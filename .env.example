# ── Database ──────────────────────────────────────────────────────────────
# Leave empty to use the embedded Postgres (PGlite) stored in ./.data — zero setup.
# For a real server:  postgres://USER:PASSWORD@localhost:5432/praana
DATABASE_URL=

# ── Redis ─────────────────────────────────────────────────────────────────
# Sessions cache, rate limits, idempotency, live care-team alerts.
# If Redis is unreachable the app falls back to in-process memory (single instance only).
REDIS_URL=redis://localhost:6379

# ── OpenAI ────────────────────────────────────────────────────────────────
# Create a key at https://platform.openai.com/api-keys (API billing is separate from ChatGPT Plus/Pro).
# Without a key PRAANA still works: check-ins are structured by the built-in rule engine,
# and the companion answers from the curated recovery library.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TIMEOUT_MS=20000

# ── Access ────────────────────────────────────────────────────────────────
# Clinicians enter this code to create a care-team account.
CLINIC_INVITE_CODE=PRAANA-CARE-2026

# ── Safety numbers (India defaults) ───────────────────────────────────────
EMERGENCY_NUMBER=112
MENTAL_HEALTH_HELPLINE=14416
MENTAL_HEALTH_HELPLINE_NAME=Tele-MANAS

APP_URL=http://localhost:3000

# ── Google Sign-In (free OAuth) ───────────────────────────────────────────
# Console: https://console.cloud.google.com/apis/credentials (OAuth client → Web)
# Redirect URIs must include: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Sarvam AI ─────────────────────────────────────────────────────────────
# Create a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=
