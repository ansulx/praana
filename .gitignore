.DS_Store
*.pem

# Google OAuth client downloads / local secrets — never commit
client_secret*.json
*googleusercontent.com.json
credentials/
**/credentials/**
google-oauth*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example
.data/

# Local working files. Kept on this machine, not part of the shared repository.
